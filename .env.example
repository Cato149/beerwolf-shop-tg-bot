# Telegram bot token from @BotFather.
BOT_TOKEN=123456:ABC-DEF

# Bot runtime mode: polling (local/dev) or webhook (production).
BOT_MODE=polling

# Public HTTPS origin of this app, no trailing slash. Required for Telegram and GitHub webhooks.
# Host must match CADDY_DOMAIN (Caddy on the server, outside Docker).
PUBLIC_BASE_URL=https://bot.example.com

# Secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token when using webhook mode.
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook

# Comma-separated Telegram user IDs that receive admin access in the bot and notifications.
ADMIN_TELEGRAM_IDS=123456789,987654321

# Contact shown to the customer when an order moves to discussion (username or t.me link text).
ADMIN_TELEGRAM_CONTACT=@beerwolf

# Bearer token for admin REST API (Authorization: Bearer ...).
ADMIN_API_TOKEN=change-me-admin-api-token

# HMAC secret used to sign customer JWT issued after Telegram initData auth.
JWT_SECRET=change-me-jwt-secret

# Customer JWT lifetime in minutes.
JWT_EXPIRE_MINUTES=10080

# SQLAlchemy async URL for Postgres (app). Host is `db` inside Compose, `localhost` for uv run.
DATABASE_URL=postgresql+asyncpg://beerwolf:beerwolf@localhost:5432/beerwolf

# Postgres image credentials. Keep in sync with DATABASE_URL. Read by the official postgres image.
POSTGRES_USER=beerwolf

# Postgres password for the database user.
POSTGRES_PASSWORD=beerwolf

# Postgres database name created on first start.
POSTGRES_DB=beerwolf

# GitHub personal access token (classic or fine-grained) with repo, issues, project, and webhook scopes.
GITHUB_TOKEN=ghp_example

# Secret used to verify X-Hub-Signature-256 on POST /webhooks/github.
GITHUB_WEBHOOK_SECRET=change-me-github-webhook

# Projects v2 Status option name treated as backlog (customer requests land here).
GITHUB_STATUS_BACKLOG=Backlog

# Projects v2 Status option name treated as in-progress for the progress message.
GITHUB_STATUS_IN_PROGRESS=In Progress

# Projects v2 Status option name treated as done (closed/completed cards).
GITHUB_STATUS_DONE=Done

# Default UI language when the user has not chosen one: ru or en.
DEFAULT_LOCALE=ru

# Public bot username without @, used in t.me/share links. If empty, taken from getMe at startup.
BOT_USERNAME=beerwolf_shop_bot

# HTTP bind host for uvicorn (container should stay 0.0.0.0).
APP_HOST=0.0.0.0

# HTTP bind port for uvicorn. Host Caddy reverse_proxies 127.0.0.1:APP_PORT (Compose publishes 8000).
APP_PORT=8000
